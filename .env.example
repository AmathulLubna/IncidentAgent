# --- Groq ---
GROQ_API_KEY=your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_PRIMARY=openai/gpt-oss-120b
GROQ_MODEL_FALLBACK=qwen/qwen3-32b

# --- Hindsight Cloud ---
HINDSIGHT_API_KEY=your-hindsight-api-key
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_PROJECT=incident-agent

# --- Consolidation / promotion tuning (defaults match the demo script) ---
CONSOLIDATION_EVERY_N=6
CONSOLIDATION_MIN_OCCURRENCES=3
PROCEDURAL_MIN_ATTEMPTS=2
PROCEDURAL_MIN_SUCCESS_RATE=0.66

# --- Misc ---
DB_PATH=incident_agent.db
CORS_ORIGINS=*

# --- Recall relevance (what may count as "why this recommendation") ---
# Results scoring below the floor are dropped before they reach the model or
# the UI, and are counted in the memory trace as weak matches.
RELEVANCE_MIN_SCORE=0.35
RELEVANCE_RELATIVE_RATIO=0.5
# Max "why this recommendation" bullets shown (best match first).
EVIDENCE_MAX_LINES=6

# --- Frontend ---
BACKEND_URL=http://localhost:8000
